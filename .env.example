# ========== 必填（接 GitHub Webhook 时）==========
GITHUB_APP_ID=
# PEM 私钥：把换行写成 \n，整段用双引号包起来
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=pr-intent-checker

# ========== 可选（不填则用启发式引擎）==========
OPENAI_API_KEY=
# 若用国内兼容网关，可改 base URL
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 对外展示的链接（写进 PR 评论）
NEXT_PUBLIC_APP_URL=http://localhost:3000
